# Local-only default. Set a strong value for any remotely reachable host.
ALEXANDRIA_POSTGRES_PASSWORD=replace-me
ALEXANDRIA_RUNTIME_PASSWORD=replace-with-random-hex-at-least-24-characters
ALEXANDRIA_MAIN_PORT=18443
ALEXANDRIA_SPC_PORT=18089
# S3 key pair shared by SeaweedFS and the server (install.sh generates random values).
ALEXANDRIA_OBJECT_ACCESS_KEY=replace-with-random-access-key
ALEXANDRIA_OBJECT_SECRET_KEY=replace-with-random-secret-at-least-32-characters
ALEXANDRIA_ADMIN_USERNAME=admin
ALEXANDRIA_MAX_CONNECTIONS=16

# Optional page recognition: handwriting -> searchable text, synced back to
# devices as page_text_from_server. Off unless ALEXANDRIA_OCR_URL is set.
# Format is anthropic (Messages API) or openai (any OpenAI-compatible chat API).
#ALEXANDRIA_OCR_URL=https://api.anthropic.com
#ALEXANDRIA_OCR_API_KEY=
#ALEXANDRIA_OCR_MODEL=
#ALEXANDRIA_OCR_FORMAT=anthropic
# Optional semantic search: an Ollama /api/embed endpoint.
#ALEXANDRIA_EMBED_URL=http://ollama:11434
#ALEXANDRIA_EMBED_MODEL=nomic-embed-text:v1.5
