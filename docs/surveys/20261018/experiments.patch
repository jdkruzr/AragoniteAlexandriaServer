+package jobs
+
+import (
+	"context"
+	"github.com/jdkruzr/AragoniteAlexandriaServer/internal/testenv"
+	"testing"
+	"time"
+)
+
+func TestSurveySameOwnerLease(t *testing.T) {
+	db := testenv.Database(t).DB
+	s := NewStore(db)
+	ctx := context.Background()
+	id, _, err := s.Enqueue(ctx, "synthetic", "survey-same-owner", nil, 5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first, err := s.ClaimID(ctx, id, "same-host", time.Minute)
+	if err != nil || first == nil {
+		t.Fatal(err)
+	}
+	if _, err = db.ExecContext(ctx, `UPDATE alexandria_jobs SET lease_until=now()-interval '1 second' WHERE id=$1`, id); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := s.RequeueExpired(ctx); err != nil || n != 1 {
+		t.Fatal(n, err)
+	}
+	second, err := s.ClaimID(ctx, id, "same-host", time.Minute)
+	if err != nil || second == nil {
+		t.Fatal(err)
+	}
+	if err = s.Complete(ctx, first.ID, "same-host"); err != nil {
+		t.Fatal(err)
+	}
+	var state string
+	if err = db.QueryRowContext(ctx, `SELECT status FROM alexandria_jobs WHERE id=$1`, id).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+	if state != "done" {
+		t.Fatal(state)
+	}
+	t.Logf("claim attempts %d -> %d: stale first completion accepted, current state=%s", first.Attempts, second.Attempts, state)
+}
