@@ -0,0 +1,55 @@
+package web
+
+import (
+	"html/template"
+	"net/http/httptest"
+	"testing"
+)
+
+// DB-free rendering of the same small page through existing and pre-parsed paths.
+func BenchmarkSurveyRendering(b *testing.B) {
+	d := Deps{}
+	r := httptest.NewRequest("GET", "/sources", nil)
+	base := template.Must(layout.Clone())
+	template.Must(base.ParseFS(assets, "templates/sources.html"))
+	baseline := httptest.NewRecorder()
+	d.render(baseline, r, "sources", "Add Source", "sources", nil)
+	check := httptest.NewRecorder()
+	clone, err := base.Clone()
+	if err != nil {
+		b.Fatal(err)
+	}
+	d.renderTemplate(check, r, clone, nil, "Add Source", "sources", nil)
+	if baseline.Code != 200 || baseline.Body.String() != check.Body.String() {
+		b.Fatal("render differs")
+	}
+	for _, cached := range []bool{false, true} {
+		name := "parse-each-request"
+		if cached {
+			name = "clone-preparsed"
+		}
+		b.Run(name, func(b *testing.B) {
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				w := httptest.NewRecorder()
+				if cached {
+					t, e := base.Clone()
+					d.renderTemplate(w, r, t, e, "Add Source", "sources", nil)
+				} else {
+					d.render(w, r, "sources", "Add Source", "sources", nil)
+				}
+				if w.Code != 200 {
+					b.Fatal(w.Code)
+				}
+			}
+		})
+	}
+}
+func BenchmarkSurveyHandlerAssembly(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		if Handler(Deps{}) == nil {
+			b.Fatal("nil")
+		}
+	}
+}
