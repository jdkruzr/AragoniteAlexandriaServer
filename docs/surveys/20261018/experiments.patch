+package boox
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	listview "github.com/jdkruzr/AragoniteAlexandriaServer/internal/listing"
+	"github.com/jdkruzr/AragoniteAlexandriaServer/internal/testenv"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSurveyAutomaticMinutesStarvation(t *testing.T) {
+	s := testService(t)
+	ctx := context.Background()
+	for i := 1; i <= 21; i++ {
+		id := fmt.Sprintf("survey-%02d", i)
+		body := fmt.Sprintf(`{"uniqueId":%q,"type":1,"status":1,"pageNameList":[]}`, id)
+		age := fmt.Sprintf("%d seconds", 3600-i)
+		if _, err := s.DB.ExecContext(ctx, `INSERT INTO boox_projection(document_id,revision,domain,native_type,native_uid,body,updated_at) VALUES($1,'1-a','notebook','1',$2,$3,now()-$4::interval)`, id, s.uid(), body, age); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := s.DB.ExecContext(ctx, `WITH v AS (INSERT INTO boox_blob_version(native_key,sha256,md5,bytes,created_at) VALUES($1,repeat('a',64),repeat('b',32),1,now()-$2::interval) RETURNING id,native_key) INSERT INTO boox_blob_live(native_key,version_id) SELECT native_key,id FROM v`, s.uid()+"/note/"+id+"/resource/data/rec.mp3", age); err != nil {
+			t.Fatal(err)
+		}
+		if i <= 20 {
+			raw := `[{"key":"resource/data/rec.mp3","sha256":"` + strings.Repeat("a", 64) + `"}]`
+			if _, err := s.DB.ExecContext(ctx, `INSERT INTO alexandria_note_minutes(source,notebook_id,request_id,state,recordings) VALUES('boox',$1,gen_random_uuid(),'ready',$2)`, id, raw); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	cfg := MinutesConfig{Enabled: true, Identity: "synthetic"}
+	since := time.Now().Add(-2 * time.Hour)
+	for i := 0; i < 3; i++ {
+		found, err := s.autoSummarize(ctx, since, cfg)
+		if err != nil || found {
+			t.Fatalf("unexpected characterization: %v %v", found, err)
+		}
+	}
+	var count int
+	if err := s.DB.QueryRowContext(ctx, `SELECT count(*) FROM alexandria_note_minutes WHERE notebook_id='survey-21'`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatal(count)
+	}
+	t.Log("21st eligible notebook not queued across 3 passes behind 20 already summarized notebooks")
+	if _, err := s.DB.ExecContext(ctx, `INSERT INTO alexandria_recognition_skip(source,notebook_id) VALUES('boox','survey-01')`); err != nil {
+		t.Fatal(err)
+	}
+	found, err := s.autoSummarize(ctx, since, cfg)
+	if err != nil || !found {
+		t.Fatalf("positive control: %v %v", found, err)
+	}
+	t.Log("21st notebook queued as soon as one earlier candidate is excluded")
+}
+
+func TestSurveyPrefixQuery(t *testing.T) {
+	db := testenv.Database(t).DB
+	ctx := context.Background()
+	for _, size := range []int{1000, 10000, 100000} {
+		if _, err := db.ExecContext(ctx, `TRUNCATE boox_blob_live,boox_blob_version CASCADE`); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := db.ExecContext(ctx, `WITH v AS (INSERT INTO boox_blob_version(native_key,sha256,md5,bytes) SELECT 'u/note/'||lpad(((i-1)/20)::text,8,'0')||'/shape/'||i,repeat('a',64),repeat('b',32),1 FROM generate_series(1,$1::int) i RETURNING id,native_key) INSERT INTO boox_blob_live(native_key,version_id) SELECT native_key,id FROM v`, size); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := db.ExecContext(ctx, `ANALYZE boox_blob_live; ANALYZE boox_blob_version`); err != nil {
+			t.Fatal(err)
+		}
+		prefix := fmt.Sprintf("u/note/%08d/", size/20-1)
+		for _, mode := range []string{"force_custom_plan", "force_generic_plan"} {
+			tx, err := db.BeginTx(ctx, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = tx.ExecContext(ctx, "SET LOCAL plan_cache_mode="+mode); err != nil {
+				t.Fatal(err)
+			}
+			for _, kind := range []string{"starts_with", "range"} {
+				predicate := `starts_with(l.native_key,$1)`
+				args := []any{prefix}
+				if kind == "range" {
+					predicate = `l.native_key >= $1 COLLATE "C" AND l.native_key < $2 COLLATE "C"`
+					args = append(args, strings.TrimSuffix(prefix, "/")+"0")
+				}
+				query := `SELECT v.native_key,v.sha256,v.bytes FROM boox_blob_live l JOIN boox_blob_version v ON v.id=l.version_id WHERE ` + predicate + ` AND NOT v.deleted ORDER BY l.native_key LIMIT 20001`
+				stmt, err := tx.PrepareContext(ctx, query)
+				if err != nil {
+					t.Fatal(err)
+				}
+				start := time.Now()
+				for i := 0; i < 30; i++ {
+					rows, e := stmt.QueryContext(ctx, args...)
+					if e != nil {
+						t.Fatal(e)
+					}
+					count := 0
+					for rows.Next() {
+						var k, sha string
+						var n int64
+						if e = rows.Scan(&k, &sha, &n); e != nil {
+							t.Fatal(e)
+						}
+						count++
+					}
+					e = rows.Err()
+					rows.Close()
+					if e != nil || count != 20 {
+						t.Fatalf("rows=%d err=%v", count, e)
+					}
+				}
+				t.Logf("rows=%d mode=%s predicate=%s repeats=30 total=%s", size, mode, kind, time.Since(start))
+				stmt.Close()
+				if size == 100000 {
+					types := "text"
+					values := fmt.Sprintf("'%s'", prefix)
+					if kind == "range" {
+						types += ",text"
+						values += fmt.Sprintf(",'%s'", strings.TrimSuffix(prefix, "/")+"0")
+					}
+					if _, err := tx.ExecContext(ctx, "PREPARE survey_plan("+types+") AS "+query); err != nil {
+						t.Fatal(err)
+					}
+					var raw []byte
+					if err := tx.QueryRowContext(ctx, "EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) EXECUTE survey_plan("+values+")").Scan(&raw); err != nil {
+						t.Fatal(err)
+					}
+					if _, err := tx.ExecContext(ctx, "DEALLOCATE survey_plan"); err != nil {
+						t.Fatal(err)
+					}
+					var plan []any
+					json.Unmarshal(raw, &plan)
+					compact, _ := json.Marshal(plan)
+					t.Logf("plan mode=%s predicate=%s %s", mode, kind, compact)
+				}
+			}
+			tx.Rollback()
+		}
+	}
+}
+
+func TestSurveyPageCountSort(t *testing.T) {
+	s := testService(t)
+	ctx := context.Background()
+	for _, v := range []struct{ id, body string }{{"a-one", `["p1"]`}, {"z-two", `["p1","p2"]`}} {
+		raw := fmt.Sprintf(`{"uniqueId":%q,"type":1,"status":1,"pageNameList":%s}`, v.id, v.body)
+		if _, e := s.DB.ExecContext(ctx, `INSERT INTO boox_projection(document_id,revision,domain,native_type,native_uid,body) VALUES($1,'1-a','notebook','1',$2,$3)`, v.id, s.uid(), raw); e != nil {
+			t.Fatal(e)
+		}
+	}
+	var first string
+	order := (listview.State{Sort: "pages", Order: "desc"}).NativeOrder()
+	if e := s.DB.QueryRowContext(ctx, "SELECT document_id FROM boox_projection ORDER BY "+order+" LIMIT 1").Scan(&first); e != nil {
+		t.Fatal(e)
+	}
+	if first != "a-one" {
+		t.Fatal("unexpected characterization", first)
+	}
+	t.Log("descending pages puts one-page a-one before two-page z-two for supported direct-array metadata")
+}
