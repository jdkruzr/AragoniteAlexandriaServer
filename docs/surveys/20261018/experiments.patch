+package library
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/jdkruzr/AragoniteAlexandriaServer/internal/alexandria/taskdb"
+)
+
+// These characterize the audited revision, including undesirable behavior.
+func TestSurveyTaskResurrection(t *testing.T) {
+	r, db, _ := fixture(t)
+	ctx := context.Background()
+	token, err := CreateToken(ctx, db, "survey")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, purge := range []bool{false, true} {
+		id := fmt.Sprintf("survey-%t", purge)
+		if w := request(r, "POST", "/api/v1/tasks", `{"id":"`+id+`","title":"Original"}`, token); w.Code != 201 {
+			t.Fatal(w.Code)
+		}
+		store := taskdb.NewStore(db)
+		if err := store.Delete(ctx, id); err != nil {
+			t.Fatal(err)
+		}
+		if purge {
+			if _, err := store.Purge(ctx, []string{id}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		w := request(r, "PUT", "/api/v1/tasks/"+id, `{"title":"Recreated"}`, token)
+		item, err := store.Get(ctx, id)
+		if err != nil || w.Code != 200 || item.Title.String != "Recreated" {
+			t.Fatalf("unexpected characterization: %d %v", w.Code, err)
+		}
+		t.Logf("purged=%t REST PUT=%d visible to shared task store=%q", purge, w.Code, item.Title.String)
+	}
+}
+
+func TestSurveyAdmissionCost(t *testing.T) {
+	r, _, _ := fixture(t)
+	ctx := context.Background()
+	for _, idle := range []int{0, 1} {
+		r.db.SetMaxIdleConns(idle)
+		for run := 0; run < 5; run++ {
+			before := r.db.Stats().MaxIdleClosed
+			start := time.Now()
+			for i := 0; i < 100; i++ {
+				_, done, err := r.admit(ctx, Read)
+				if err != nil {
+					t.Fatal(err)
+				}
+				done()
+			}
+			t.Logf("idle=%d run=%d admissions=100 duration=%s closed=%d", idle, run, time.Since(start), r.db.Stats().MaxIdleClosed-before)
+		}
+	}
+}
+
+func TestSurveyRESTKeepsClientTimestamp(t *testing.T) {
+	r, db, _ := fixture(t)
+	ctx := context.Background()
+	token, err := CreateToken(ctx, db, "survey")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, title := range []string{"first", "changed"} {
+		body := fmt.Sprintf(`{"id":"timestamp","title":%q,"updated_at":1000,"last_modified":1000}`, title)
+		if w := request(r, "POST", "/api/v1/tasks", body, token); w.Code != 201 {
+			t.Fatal(w.Code)
+		}
+	}
+	item, err := taskdb.NewStore(db).Get(ctx, "timestamp")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if item.UpdatedAt != 1000 || item.Title.String != "changed" {
+		t.Fatal("unexpected characterization")
+	}
+	t.Log("REST changed task title while updated_at stayed at client-supplied 1000")
+}
